# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채운다. .env 는 저장소에 올리지 않는다.

# 이메일 발송 (지메일)
# SMTP_PASSWORD 는 구글 계정 비밀번호가 아니라 "앱 비밀번호" 16자리 (2단계 인증을 켜야 만들 수 있음)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=학과 공지 알림

# 1 이면 실제로 보내지 않고 server/outbox/ 에 .eml 파일로 저장 (SMTP_USER 가 비어 있어도 그렇게 동작)
MAIL_DRY_RUN=1

# 로그인 세션 서명용 비밀 값 (아무도 모르는 긴 무작위 글자). 만드는 법:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 우리 서비스 주소 (메일 속 "서비스에서 보기" 링크용, 비워두면 링크 생략)
SITE_URL=
